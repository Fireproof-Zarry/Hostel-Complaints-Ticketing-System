DB_PASSWORD=replace-with-your-supabase-database-password
ADMIN_EMAILS=<comma-separated-admin-emails>

# Supabase project URL and key, for complaint photos
SUPABASE_URL=
SUPABASE_KEY=

# Firebase service account file, for notifications. Leave empty to turn them off
FIREBASE_CONFIG_PATH=

# Set to false in production
SHOW_SQL=true
